requisition_counter = 10000
class Requisition:

    requisitions = []

    def __init__(self, date, staff_id, staff_name):

        global requisition_counter
        requisition_counter += 1

        self.date = date
        self.staff_id = staff_id
        self.staff_name = staff_name
        self.requisition_id = requisition_counter
        self.total = 0
        self.items = {}
        self.status = "Pending"
        self.approval_reference = "Not available"

        Requisition.requisitions.append(self)

    def add_requisition(self, items):

        if not isinstance(items, dict) or not items:
            raise ValueError("Please enter valid requisition items.")

        for item, cost in items.items():

            if not isinstance(item, str) or not item.strip():
                raise ValueError("Invalid item name.")

            if (isinstance(cost, bool)
                    or not isinstance(cost, (int, float))
                    or cost <= 0):
                raise ValueError("Invalid item cost.")

        self.items = items.copy()
        self.total = sum(items.values())
        self.approve_requisition()

        return self.total

    def approve_requisition(self):

        if self.total < 500:

            self.status = "Approved"

            self.approval_reference = (
                str(self.staff_id) + str(self.requisition_id)[-3:]
            )

        else:

            self.status = "Pending"
            self.approval_reference = "Not available"

        return self.status

    def respond_requisition(self, decision):

        if self.status != "Pending":
            print("This requisition is not pending.")
            return False

        if not isinstance(decision, str):
            print("Invalid decision.")
            return False

        decision = decision.strip().lower()

        if decision == "approved":

            self.status = "Approved"

            self.approval_reference = (
                str(self.staff_id) + str(self.requisition_id)[-3:]
            )

            return True

        elif decision == "not approved":

            self.status = "Not approved"
            self.approval_reference = "Not available"

            return True

        else:
            print("Invalid decision.")
            return False

    @classmethod
    def display_requisitions(cls):

        if not cls.requisitions:
            print("No requisitions submitted.")
            return

        for requisition in cls.requisitions:

            print("\nDate:", requisition.date)
            print("Requisition ID:", requisition.requisition_id)
            print("Staff ID:", requisition.staff_id)
            print("Staff Name:", requisition.staff_name)
            print(f"Total: ${requisition.total}")
            print("Status:", requisition.status)
            print("Approval Reference Number:", requisition.approval_reference)

    @classmethod
    def requisition_statistics(cls):

        total_requisitions = len(cls.requisitions)

        approved = 0
        pending = 0
        not_approved = 0

        for requisition in cls.requisitions:

            if requisition.status == "Approved":
                approved += 1

            elif requisition.status == "Pending":
                pending += 1

            elif requisition.status == "Not approved":
                not_approved += 1

        statistics = {
            "Total requisitions": total_requisitions,
            "Approved requisitions": approved,
            "Pending requisitions": pending,
            "Not approved requisitions": not_approved
        }

        for key, value in statistics.items():
            print(key + ":", value)

        return statistics

        req1 = Requisition("19/11/2026", "FN19", "John Paul")
req1.add_requisition({"Keyboard": 100, "Mouse": 50, "Monitor": 100})

req2 = Requisition("19/11/2026", "FN20", "Tracy Brown")
req2.add_requisition({"Laptop": 800, "Keyboard": 200})

req3 = Requisition("19/11/2026", "FN15", "Emma Wellington")
req3.add_requisition({"Computer": 2500, "Printer": 1000})

req4 = Requisition("19/11/2026", "FN02", "Catlin White")
req4.add_requisition({"Headphones": 290, "Mouse": 200})

req5 = Requisition("19/11/2026", "FN10", "David Smith")
req5.add_requisition({"Desk": 400, "Chair": 200})

req2.respond_requisition("Approved")
req3.respond_requisition("Not approved")

Requisition.display_requisitions()
Requisition.requisition_statistics()
