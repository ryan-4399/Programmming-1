
requisition_counter = 1000
class Requisition:
    requisitions = []

    def __init__(self, date, staff_id, staff_name):

        #Adding req.
        global requisition_counter
        requisition_counter += 1

        self.date = date
        self.staff_id = staff_id
        self.staff_name = staff_name
        self.requisition_id = requisition_counter
        self.total = 0
        self.items = {}
        self.status = "Pending"
        self.approval_reference = "Not available"

        Requisition.requisitions.append(self)

    def add_requisition(self, items):


    def add_requisition(self, items):
        if not isinstance(items, dict) or not items:
            raise ValueError("Please enter valid items.")

        for item, cost in items.items():

            if not isinstance(item, str) or not item.strip():
                raise ValueError("Invalid item name.")

            if not isinstance(cost, (int, float)) or isinstance(cost, bool) or cost <= 0:
                raise ValueError("Invalid item cost.")
        self.items = items.copy()
        self.total = sum(items.values())

        return self.total
 def approve_requisition(self):
    if self.total < 500:
        self.status = "Approved"

        self.approval_reference = (
            str(self.staff_id) + str(self.requisition_id)[-3:]
        )

    else:

        self.status = "Pending"
        self.approval_reference = "Not available"

    return self.status



    def respond_requisition(self, decision):
#this code decision and approval.
        if self.status != "Pending":
            print("Requisition is not pending.")
            return False
        if decision == "Approved":

            self.status = "Approved"
            self.approval_reference = (
                str(self.staff_id) + str(self.requisition_id)[-3:]
            )

        elif decision == "Not approved":

            self.status = "Not approved"
            self.approval_reference = "Not available"
        else:
            print("Invalid decision.")
            return False
        return True